{
  "name": "libre-weather",
  "version": "1.8.0",
  "private": true,
  "license": "AGPL-3.0",
  "author": "jkuester",
  "contributors": [
    "tobitenno"
  ],
  "scripts": {
    "build": "npm run build:licenses && parcel build ./src/index.html --no-cache",
    "build:docker": "docker build -t libreweather/frontend:latest .",
    "build:licenses": "node scripts/generateLicenses.cjs",
    "coverage": "jest --config .config/jest.config.cjs --coverage",
    "lint": "eslint . --config .config/eslint.config.mjs",
    "lint:fix": "eslint . --config .config/eslint.config.mjs --fix",
    "prepare": "husky || exit 0",
    "serve": "serve -p $PORT -s dist/.",
    "start": "parcel ./src/index.html --no-cache",
    "test": "jest --config .config/jest.config.cjs",
    "test:e2e": "cypress run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "preact": "^10.29.8",
    "react-animated-weather": "^4.0.1",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.0",
    "@parcel/packager-raw-url": "^2.16.0",
    "@parcel/service-worker": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^30.1.2",
    "cypress": "^16.1.0",
    "dotenv": "^17.2.2",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-yml": "^1.19.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "lint-staged": "^16.1.6",
    "parcel": "^2.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24"
  },
  "alias": {
    "@/common/*": "./src/components/common/$1",
    "@components/*": "./src/components/$1",
    "@/utilities/*": "./src/utilities/$1",
    "@/models/*": "./src/models/$1",
    "@/hooks/*": "./src/hooks/$1",
    "@/api/*": "./src/api/$1",
    "@/providers/*": "./src/providers/$1",
    "react": "preact/compat",
    "react-dom": "preact/compat",
    "react-dom/client": "preact/compat/client",
    "react/jsx-runtime": "preact/jsx-runtime",
    "react/jsx-dev-runtime": "preact/jsx-runtime"
  }
}

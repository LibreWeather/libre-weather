{
  "name": "libre-weather",
  "version": "1.0.5",
  "private": true,
  "license": "AGPL-3.0",
  "author": "jkuester",
  "contributors": [
    "tobitenno"
  ],
  "scripts": {
    "build": "npm run build:licenses && parcel build ./src/index.html --no-cache",
    "build:docker": "docker build -t libreweather/frontend:latest .",
    "build:licenses": "node src/utilities/generateLicenses.js",
    "coverage": "jest --config .config/jest.config.cjs --coverage",
    "lint": "eslint . --config .config/eslint.config.mjs",
    "lint:fix": "eslint . --config .config/eslint.config.mjs --fix",
    "prepare": "husky || exit 0",
    "serve": "serve -p $PORT -s dist/.",
    "start": "parcel ./src/index.html --no-cache",
    "test": "jest --config .config/jest.config.cjs"
  },
  "babel": {
    "plugins": [
      "@babel/plugin-transform-react-jsx"
    ],
    "presets": []
  },
  "release": {
    "extends": "./.config/.releaserc.yaml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@parcel/babel-preset-env": "^2.16.0",
    "@parcel/packager-raw-url": "^2.16.0",
    "@parcel/transformer-less": "^2.16.0",
    "@parcel/transformer-webmanifest": "^2.16.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.1.2",
    "bootstrap": "^5.3.8",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.2",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-yml": "^1.19.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "less": "^4.4.1",
    "license-list": "^0.1.3",
    "lint-staged": "^16.1.6",
    "parcel": "^2.16.0",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-animated-weather": "^4.0.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-router": "^7.8.2",
    "react-router-dom": "^7.8.2",
    "react-test-renderer": "^18.3.1",
    "regenerator-runtime": "^0.14.1"
  },
  "engines": {
    "node": ">=24"
  },
  "alias": {
    "@/common/*": "./src/components/common/$1",
    "@components/*": "./src/components/$1",
    "@/utilities/*": "./src/utilities/$1",
    "react-router/dom": "./node_modules/react-router/dist/development/dom-export.js"
  }
}
